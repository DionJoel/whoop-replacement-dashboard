# ============================================
# WHOOP-Alternative Dashboard - Umgebungsvariablen
# ============================================
# Kopiere diese Datei zu .env und passe die Werte an!
# NIEMALS die .env-Datei ins Repository commiten!

# ============================================
# Hardware: Fujitsu ESPRIMO Q556 (i7-6700T, 32 GB RAM)
# ============================================
# Empfohlenes Modell: mistral-7b-instruct:q4_0 (6.5 GB RAM)
# Alternativen:
# - gemma4:e4b-qat (8 GB RAM)
# - phi3:3.8b-mini-instruct-4k-fp16 (3 GB RAM, schneller)

# ============================================
# Datenbank-Konfiguration (TimescaleDB)
# ============================================
POSTGRES_USER=dion
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN
POSTGRES_DB=athlete_metrics
DB_HOST=timescaledb  # Docker-Service-Name (nicht ändern!)
DB_PORT=5432

# ============================================
# n8n-Konfiguration
# ============================================
# Basic Auth für n8n-Webinterface
N8N_USER=admin
N8N_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN

# Webhook-URL (falls extern zugänglich)
WEBHOOK_URL=https://deine-subdomain.duckdns.org/

# Zeitzone für Cronjobs
GENERIC_TIMEZONE=Europe/Berlin

# ============================================
# Ollama-Konfiguration
# ============================================
OLLAMA_URL=http://ollama:11434  # Docker-interner Hostname
OLLAMA_MODEL=mistral-7b-instruct:q4_0  # Empfohlen für i7-6700T mit 32 GB RAM (6.5 GB)
# Alternativen:
# - gemma4:e4b-qat (8 GB RAM)
# - phi3:3.8b-mini-instruct-4k-fp16 (3 GB RAM, schneller)

# ============================================
# MCP-Server-Konfiguration
# ============================================
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=0.0.0.0

# ============================================
# API-Credentials (Polar)
# ============================================
# Registriere deine App unter: https://admin.polar.com/personal-access-tokens
POLAR_CLIENT_ID=DEIN_POLAR_CLIENT_ID
POLAR_CLIENT_SECRET=DEIN_POLAR_CLIENT_SECRET
POLAR_REDIRECT_URI=http://localhost:3000/polar/callback
POLAR_SCOPE=sleep,activity,read_all_user_data
POLAR_ACCESS_TOKEN=DEIN_POLAR_ACCESS_TOKEN  # Wird nach OAuth2-Flow generiert
POLAR_REFRESH_TOKEN=DEIN_POLAR_REFRESH_TOKEN

# ============================================
# API-Credentials (Intervals.icu)
# ============================================
# API-Key unter: https://intervals.icu/user/settings
INTERVALS_KEY=DEIN_INTERVALS_API_KEY
ATHLETE_ID=DEINE_ATHLETE_ID  # Deine Athlete-ID von Intervals.icu
INTERVALS_API_BASE_URL=https://intervals.icu/api/v1

# ============================================
# API-Credentials (Habitica)
# ============================================
# API-Key unter: https://habitica.com/apidocs/#api-keys
HABITICA_USER_ID=DEINE_HABITICA_USER_ID
HABITICA_API_TOKEN=DEIN_HABITICA_API_KEY

# ============================================
# API-Credentials (Hevy)
# ============================================
# API-Key unter: https://hevyapp.com/settings/api
HEVY_API_KEY=DEIN_HEVY_API_KEY

# ============================================
# API-Credentials (Withings)
# ============================================
# App registrieren unter: https://developer.withings.com/
WITHINGS_CLIENT_ID=DEINE_WITHINGS_CLIENT_ID
WITHINGS_CLIENT_SECRET=DEIN_WITHINGS_CLIENT_SECRET
WITHINGS_REDIRECT_URI=https://deine-domain.de/withings/callback
WITHINGS_ACCESS_TOKEN=DEIN_WITHINGS_ACCESS_TOKEN  # Wird nach OAuth2-Flow generiert
WITHINGS_REFRESH_TOKEN=DEIN_WITHINGS_REFRESH_TOKEN
WITHINGS_USER_ID=DEINE_WITHINGS_USER_ID

# ============================================
# Cronometer (Web-Wrapper für Ernährungsdaten)
# ============================================
# Hinweis: Cronometer hat keine offizielle API. Ein Proxy-Server ist nötig.
CRONOMETER_USERNAME=DEINE_CRONOMETER_EMAIL
CRONOMETER_PASSWORD=DEIN_CRONOMETER_PASSWORT
CRONOMETER_PROXY_URL=http://dein-proxy-host:3128

# ============================================
# E-Mail-Konfiguration (für Benachrichtigungen)
# ============================================
# Beispiel für Gmail (mit App-Passwort)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false  # true für Port 465
SMTP_USER=deine.email@gmail.com
SMTP_PASSWORD=DEIN_APP_PASSWORT  # Nicht das normale Passwort!
SMTP_FROM=deine.email@gmail.com
SMTP_TO=deine.email@gmail.com

# Beispiel für Mailgun (empfohlen für Docker)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@deine-domain.de
# SMTP_PASSWORD=DEIN_MAILGUN_API_KEY

# ============================================
# Backup-Konfiguration
# ============================================
# Pfad für Backups (auf dem Host-System)
BACKUP_DIR=/backups/whoop-dashboard

# Retention für Backups (Tage)
BACKUP_RETENTION_DAYS=30

# ============================================
# Docker-spezifische Einstellungen
# ============================================
# Docker-Netzwerk (wird in docker-compose.yml verwendet)
DOCKER_NETWORK=app_network

# ============================================
# Security-Hinweise
# ============================================
# 1. NIEMALS diese Datei als .env ins Repository commiten!
# 2. Ollama nur auf 127.0.0.1 binden (siehe docker-compose.yml)
# 3. Datenbank-Ports nur lokal zugänglich machen
# 4. API-Keys regelmäßig rotieren (alle 6 Monate)
# 5. Backups verschlüsseln (z. B. mit gpg)
