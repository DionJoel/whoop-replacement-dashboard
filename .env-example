# ============================================
# WHOOP-Alternative Dashboard - Umgebungsvariablen
# ============================================
# 1. Kopiere diese Datei zu .env:
#    cp .env-example .env
# 2. Trage ALLE Platzhalter (DEIN_..., HIER_...) mit deinen echten Werten ein.
# 3. NIEMALS die .env-Datei ins Repository commiten!
#    (.env ist bereits in .gitignore)
#
# Hardware: Fujitsu ESPRIMO Q556 (i7-6700T, 32 GB RAM)
# Empfohlenes Modell: mistral-7b-instruct:q4_0 (6.5 GB RAM)
# RAM-Verteilung: TimescaleDB (8GB) + Ollama (6.5GB) + n8n (4GB) + 5 MCP-Server (2.5GB) = ~21GB
#
# ============================================

# ============================================
# 🗃️  DATENBANK (TimescaleDB)
# ============================================
# Wird von allen MCP-Servern und n8n genutzt.
# Standard-Port: 5432
#
POSTGRES_USER=dion # Dein PostgreSQL Benutzername
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN
POSTGRES_DB=athlete_metrics
DB_HOST=timescaledb  # Docker-Service-Name (Nicht ändern!)
DB_PORT=5432

# ============================================
# 🤖  OLLAMA (Lokale KI)
# ============================================
# URL für n8n: http://ollama:11434 (Docker-intern)
# oder http://localhost:11434 (lokal auf Fujitsu)
#
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral-7b-instruct:q4_0  # Empfohlen für i7-6700T + 32 GB RAM (oder dein gewähltes Modell)

# ============================================
# 🔐  N8N (Workflow-Automation)
# ============================================
# Basic Auth für n8n-Webinterface (http://localhost:5678)
# Wichtig: Auf Fujitsu aktivieren, in Codespace deaktiviert (siehe docker-compose-codespace.yml)
#
N8N_USER=admin
N8N_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN # Dein n8n Admin-Passwort

# Zeitzone für Cronjobs (z. B. "0 9 * * *" = 9 Uhr MEZ)
GENERIC_TIMEZONE=Europe/Berlin

# Webhook-URL (falls extern zugänglich - optional)
WEBHOOK_URL=

# ============================================
# 📡  DISCORD (für Daily Report + Error Notifications)
# ============================================
# Anleitung:
# 1. Discord-Server erstellen: https://support.discord.com/hc/de/articles/204849977
# 2. Text-Channel erstellen (z. B. #ai-coach-reports)
# 3. Channel-Einstellungen → Integrationen → Neuer Webhook → URL kopieren
# Beispiel: https://discord.com/api/webhooks/123456789/abcdefghijklmnop
#
DISCORD_WEBHOOK_URL=

# ============================================
# 🏃‍♂️  MCP-SERVER CREDENTIALS (für selbstgehostete Server)
# ============================================
# Jeder MCP-Server braucht eigene API-Credentials.
# Die Server laufen lokal auf dem Fujitsu und werden von n8n oder direkt von Claude genutzt.
#
# --------------------------------------------------------------------
# 🌍 POLAR (https://github.com/NelsonNew/polar-mcp-server) - Lokal gehostet
# --------------------------------------------------------------------
# Anleitung:
# 1. Gehe zu: https://admin.polaraccesslink.com/
# 2. Registriere eine neue App
# 3. Setze Redirect URI auf: http://localhost:3000/polar/callback
# 4. Wähle Scopes: sleep,activity,read_all_user_data
# 5. Kopiere Client ID und Client Secret
#
POLAR_CLIENT_ID=DEIN_POLAR_CLIENT_ID
POLAR_CLIENT_SECRET=DEIN_POLAR_CLIENT_SECRET
POLAR_REDIRECT_URI=http://localhost:3000/polar/callback # Nicht ändern, wenn lokal gehostet
POLAR_SCOPE=sleep,activity,read_all_user_data # Nicht ändern

# --------------------------------------------------------------------
# 📊 INTERVALS.ICU (https://github.com/mvilanova/intervals-mcp-server)
# --------------------------------------------------------------------
# Anleitung:
# 1. Gehe zu: https://intervals.icu/user/settings
# 2. Scrolle zu "API Key"
# 3. Generiere einen neuen Key
# 4. Finde deine Athlete ID in der URL: https://intervals.icu/athlete/12345
#
INTERVALS_KEY=DEIN_INTERVALS_API_KEY
ATHLETE_ID=DEINE_ATHLETE_ID

# --------------------------------------------------------------------
# ⚖️ WITHINGS (https://withings-mcp.com) - Öffentlich gehostet
# --------------------------------------------------------------------
# Keine Credentials hier nötig! Die Autorisierung erfolgt direkt über den öffentlichen MCP-Server.

# --------------------------------------------------------------------
# 🥗 CRONOMETER (https://github.com/modelcontextprotocol/servers/tree/main/src/cronometer)
# --------------------------------------------------------------------
# Anleitung:
# 1. Gehe zu: https://cronometer.com/
# 2. Logge dich ein
# 3. Nutze deine E-Mail und dein Passwort
#
# HINWEIS: Cronometer hat keine offizielle API.
# Der MCP-Server verwendet einen Web-Login-Wrapper.
#
CRONOMETER_USERNAME=DEINE_CRONOMETER_EMAIL
CRONOMETER_PASSWORD=DEIN_CRONOMETER_PASSWORT

# ============================================
# 🍎  LEGACY API-CREDENTIALS (nur falls nicht über MCP)
# ============================================
# Falls du einige APIs doch direkt über n8n abfragen willst (nicht empfohlen).
#
# POLAR_ACCESS_TOKEN=
# POLAR_REFRESH_TOKEN=

# ============================================

# ============================================
# 💾  BACKUP
# ============================================
# Pfad für Backups (auf dem Host-System)
BACKUP_DIR=/backups/whoop-dashboard
# Retention für Backups (Tage)
BACKUP_RETENTION_DAYS=30

# ============================================
# 🌐  DOCKER-SPEZIFISCHE EINSTELLUNGEN
# ============================================
# Docker-Netzwerk (wird in docker-compose.yml verwendet)
DOCKER_NETWORK=app_network
#
# ============================================
# 🔒  SECURITY-HINWEISE
# ============================================
# 1. NIEMALS diese Datei als .env ins Repository commiten!
# 2. Ollama nur auf 127.0.0.1 binden (siehe docker-compose.yml)
# 3. Datenbank-Ports nur lokal zugänglich machen
# 4. API-Keys regelmäßig rotieren (alle 6 Monate)
# 5. Backups verschlüsseln (z. B. mit gpg)
# ============================================
