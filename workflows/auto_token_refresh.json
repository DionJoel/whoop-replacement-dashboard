{
  "name": "Polar Token Auto Refresh",
  "nodes": [
    {
      "parameters": {
        "cronExpression": "0 * * * *"  // Jede Stunde ausführen
      },
      "id": "trigger",
      "name": "Hourly Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "url": "https://httpbin.org/get",  // Einfacher Test-Endpoint
        "options": {
          "ignoreHttpStatusErrors": true,
          "errorOnMissingAuth": false
        }
      },
      "id": "token_test",
      "name": "Test & Refresh Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300],
      "credentials": {
        "oAuth2Api": {
          "id": "polar_oauth2",
          "field": "oauth2"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "=\"Token refresh attempted at: \" & $now.format(\"YYYY-MM-DD HH:mm:ss\")"
            }
          ]
        }
      },
      "id": "log_status",
      "name": "Log Status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "text": "=\"Token Refresh: \" & $node[\"log_status\"].json[\"status\"]",
        "output": "all"
      },
      "id": "notify",
      "name": "Notify",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "trigger": {
      "main": [
        [
          {
            "node": "token_test",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "token_test": {
      "main": [
        [
          {
            "node": "log_status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "log_status": {
      "main": [
        [
          {
            "node": "notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}