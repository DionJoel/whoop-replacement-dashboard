{
  "name": "Intervals.ICU MCP Test",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://intervals-mcp:3001/mcp",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",
  \"id\": 1,
  \"method\": \"initialize\",
  \"params\": {
    \"protocolVersion\": \"2024-11-05\",
    \"capabilities\": {},
    \"clientInfo\": {
      \"name\": \"n8n\",
      \"version\": \"1.0\"
    }
  }
}",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json, text/event-stream"
        },
        "options": {
          "response": {
            "response": {
              "format": "text"
            }
          }
        }
      },
      "name": "MCP Initialize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://intervals-mcp:3001/mcp",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",
  \"id\": 2,
  \"method\": \"tools/call\",
  \"params\": {
    \"name\": \"get_activities\",
    \"arguments\": {}
  }
}",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json, text/event-stream",
          "mcp-session-id": "={{ $node[\"MCP Initialize\"].json[\"mcp-session-id\"] || $node[\"MCP Initialize\"].json[0][\"mcp-session-id\"] }}"
        },
        "options": {
          "response": {
            "response": {
              "format": "text"
            }
          }
        }
      },
      "name": "Get Activities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Check Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "webhookUrl": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "text": "🚨 **MCP-Server Fehler**\n\nNode: {{ $node.name }}\nFehler: {{ $json.error || $json.message || 'Unbekannter Fehler' }}",
        "options": {}
      },
      "name": "Discord Error",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1050, 400]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "MCP Initialize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "MCP Initialize": {
      "main": [
        [
          {
            "node": "Get Activities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Activities": {
      "main": [
        [
          {
            "node": "Check Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Error": {
      "main": [
        [
          {
            "node": "Discord Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "meta": {
    "instanceId": "test-workflow"
  }
}
