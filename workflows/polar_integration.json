{
  "name": "Polar Sleep Data to TimescaleDB",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "e30b6b23-286a-4f10-bc52-19e992161b9a",
      "name": "Schedule Trigger (06:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "url": "https://www.polaraccesslink.com/v2/users/me/sleep",
        "options": {
          "headers": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "c1a2b3c4-d5e6-4f7a-8b9c-0d1e2f3a4b5c",
      "name": "Get Polar Sleep Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "credentials": {
        "oAuth2Api": {
          "id": "polar_oauth2_credential_id",
          "field": "oauth2"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO polar_metrics (timestamp, hrv_rmssd, resting_heart_rate, sleep_score, cardio_load)\nVALUES (\n  '{{ $json.sleep && $json.sleep[0] ? $json.sleep[0].date : $now }}',\n  {{ $json.sleep && $json.sleep[0] ? $json.sleep[0].hrv_rmssd : 'NULL' }},\n  {{ $json.sleep && $json.sleep[0] ? $json.sleep[0].resting_heart_rate : 'NULL' }},\n  {{ $json.sleep && $json.sleep[0] ? $json.sleep[0].sleep_score : 'NULL' }},\n  NULL\n)\nON CONFLICT DO NOTHING;"
      },
      "id": "f8e7d6c5-b4a3-4f2e-1d0c-9b8a7f6e5d4c",
      "name": "Insert into TimescaleDB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [720, 300],
      "credentials": {
        "postgres": {
          "id": "timescaledb_credential_id",
          "field": "postgres"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger (06:00 AM)": {
      "main": [
        [
          {
            "node": "Get Polar Sleep Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Polar Sleep Data": {
      "main": [
        [
          {
            "node": "Insert into TimescaleDB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}