{
  "name": "Daily AI Coach Newsletter",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM view_ai_daily_context ORDER BY day_date DESC LIMIT 3;"
      },
      "name": "Fetch DB Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "DEINE_CREDENTIAL_ID",
          "name": "TimescaleDB"
        }
      },
      "options": {
        "retryOnFail": true,
        "maxTries": 3,
        "delayBetweenTries": 2000
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ JSON.stringify($json.error) }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Check DB Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "mistral-7b-instruct:q4_0"
            },
            {
              "name": "prompt",
              "value": "={{ 'Du bist mein elitärer KI-Athletik-Coach. Schreibe mir mein heutiges Morgen-Briefing als kompakte E-Mail in Markdown (mit passenden Emojis). Analysiere meine Daten der letzten 3 Tage (Schlaf/HRV, Trainingsbelastung/Fatigue, Krafttraining-Volumen und Habitica-Tasks). Erkenne Trends und gib mir EINE konkrete Trainingsempfehlung für heute (z.B. \"Erholung\", \"Fokus auf Cardio\" oder \"Push dich\"). Erwähnne keine technischen JSON-Keys, sondern formuliere es flüssig. Hier sind meine Rohdaten: ' + JSON.stringify($json) }}"
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        },
        "options": {
          "retryOnFail": true,
          "maxTries": 2,
          "delayBetweenTries": 5000,
          "timeout": 60000
        }
      },
      "name": "Ollama LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Check Ollama Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "webhookUrl": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "text": "🚀 **Dein Daily AI Coach Briefing**\n\n{{ $json.response }}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "delayBetweenTries": 5000
        }
      },
      "name": "Send Discord Report",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-discord-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Check Discord Report Error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "webhookUrl": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "text": "🚨 **FEHLER im Daily AI Coach Workflow!**\n\nNode: {{ $node.name }}\nFehler: {{ $json.error || $json.message || 'Unbekannter Fehler' }}\nZeit: {{ new Date().toISOString() }}\nDaten: {{ JSON.stringify($json).substring(0, 500) }}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3
        }
      },
      "name": "Send Discord Error",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Fetch DB Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch DB Data": {
      "main": [
        [
          {
            "node": "Check DB Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check DB Error": {
      "main": [
        [
          {
            "node": "Ollama LLM",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Discord Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama LLM": {
      "main": [
        [
          {
            "node": "Check Ollama Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Ollama Error": {
      "main": [
        [
          {
            "node": "Send Discord Report",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Discord Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Discord Report": {
      "main": [
        [
          {
            "node": "Check Discord Report Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Discord Report Error": {
      "main": [
        [
          {
            "node": "Send Discord Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}