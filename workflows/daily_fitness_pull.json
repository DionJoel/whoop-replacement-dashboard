    {
      "parameters": {
        "url": "http://ollama:11434/api/generate",
        "authentication": "none",
        "method": "POST",
        "body": {
          "model": "={{ $env.OLLAMA_MODEL }}",
          "prompt": "={{ $node[\"Generate AI Prompt\"].json[\"prompt\"] }}",
          "stream": false,
          "options": {
            "temperature": 0.7,
            "top_p": 0.9
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "delayBetweenTries": 5000,
          "timeout": 60000
        }
