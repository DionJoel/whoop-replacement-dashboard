      "id": "call-ollama",
      "name": "Call Ollama API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1450,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// Generiere den Prompt für die KI
const dailyData = items[0]?.json[0];

if (!dailyData) {
  return [{ json: { prompt: 'Keine Daten für heute verfügbar.' } }];
}

// Formatiere die Daten für den Prompt
const formattedData = {
  datum: dailyData.day_date,
  hrv: dailyData.hrv_rmssd || '-',
  ruhepuls: dailyData.resting_heart_rate || '-',
  schlaf_score: dailyData.sleep_score || '-',
  cardio_load: dailyData.cardio_load || '-',
  recovery_score: dailyData.recovery_score || '-',
  fitness_ctl: dailyData.fitness_ctl || '-',
  fatigue_atl: dailyData.fatigue_atl || '-',
  form_tsb: dailyData.form_tsb || '-',
  strength_volume: dailyData.strength_volume_kg || '-',
  strength_reps: dailyData.strength_reps || '-',
  strength_rpe: dailyData.strength_rpe || '-',
  gewicht: dailyData.weight_kg || '-',
  koerperfett: dailyData.body_fat_percent || '-',
  muskelmasse: dailyData.muscle_mass_kg || '-',
  hydration: dailyData.hydration_percent || '-',
  completed_tasks: dailyData.completed_tasks || '-',
  total_tasks: dailyData.total_tasks || '-',
  completion_rate: dailyData.completion_rate || '-'
};

// System-Prompt für den KI-Coach
const systemPrompt = `
Du bist ein erfahrener Athletik-Coach und Analyst. Analysiere die folgenden Daten und erstelle eine 
**kompakte, strukturierte Zusammenfassung** mit:

1. **Aktueller Status** (1-2 Sätze)
2. **Schlaf & Regeneration** (HRV, Ruhepuls, Schlaf-Score)
3. **Trainingsbelastung** (CTL/ATL/TSB, Cardio-Load, Krafttrainings-Volumen)
4. **Körperliche Verfassung** (Gewicht, Körperfett, Muskelmasse, Hydration)
5. **Habitica-Statistik** (Produktivität)
6. **Empfehlungen für heute** (max. 3 konkrete Punkte)

**Wichtig:**
- Antworte **ausschließlich in Markdown** (kein Plaintext!)
- Nutze **Überschriften** (##, ###) und **Aufzählungen** für Struktur
- Sei **präzise und knapp** (max. 200 Wörter)
- Verwende **keine** Emojis oder Smalltalk
- Basierend auf den Daten:
${JSON.stringify(formattedData, null, 2)}
`;

return [{ json: { prompt: systemPrompt } }];"
      },
      "id": "generate-ai-prompt",
      "name": "Generate AI Prompt",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1250,
        500
      ]
    },
    {
      "parameters": {
        "functionCode": "// Extrahiere die KI-Antwort aus dem Ollama-Response
const response = items[0]?.json;

if (!response || !response.response) {
  return [{ json: { markdown: 'Keine Antwort von der KI erhalten.' } }];
}

// Die Antwort ist in response.response
const aiResponse = response.response;

// Erstelle das finale Markdown-Dokument
const finalMarkdown = `# Athletik Dashboard - ${new Date().toLocaleDateString('de-DE')}

${aiResponse}

---
*Generiert am: ${new Date().toLocaleString('de-DE')}*
*Modell: ${response.model || 'Unbekannt'}*
`;

return [{ json: { markdown: finalMarkdown, filename: `00_Athletik_Dashboard_${new Date().toISOString().split('T')[0]}.md` } }];"
      },
      "id": "format-ai-response",
      "name": "Format AI Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1650,
        300
      ]
