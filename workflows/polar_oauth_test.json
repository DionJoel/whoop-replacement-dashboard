{
  "name": "Polar OAuth2 Test",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "url": "https://www.polaraccesslink.com/v2/users/me",
        "options": {
          "headers": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ],
          "ignoreHttpStatusErrors": true
        }
      },
      "id": "polar_api_test",
      "name": "Test Polar API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300],
      "credentials": {
        "oAuth2Api": {
          "id": "polar_oauth2",
          "field": "oauth2"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "api_response",
              "value": "={{$node[\"polar_api_test\"].json}}"
            },
            {
              "name": "status_code",
              "value": "={{$node[\"polar_api_test\"].statusCode}}"
            }
          ]
        }
      },
      "id": "capture_response",
      "name": "Capture Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error_message",
              "value": "={{$node[\"polar_api_test\"].error}}"
            }
          ]
        }
      },
      "id": "capture_error",
      "name": "Capture Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 400]
    }
  ],
  "connections": {
    "start": {
      "main": [
        [
          {
            "node": "polar_api_test",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "polar_api_test": {
      "main": [
        [
          {
            "node": "capture_response",
            "type": "main",
            "index": 0
          },
          {
            "node": "capture_error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}